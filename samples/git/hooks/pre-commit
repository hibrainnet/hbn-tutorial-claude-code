#!/bin/bash

# 스테이징된 파일들 중 변경 사항이 있는 파일 목록을 가져옵니다.
STAGED_FILES=$(git diff --cached --name-only)

for FILE in $STAGED_FILES; do
    # 파일 내용 중 'TODO'라는 단어가 있는지 검사합니다.
    if grep -q "TODO" "$FILE"; then
        echo "❌ 오류: $FILE 파일에 'TODO' 주석이 남아있습니다. 해결 후 커밋하세요."
        exit 1 # 0이 아닌 값을 반환하면 커밋이 중단됩니다.
    fi
done

echo "✅ 모든 검사를 통과했습니다. 커밋을 진행합니다."
exit 0